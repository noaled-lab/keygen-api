#!/bin/bash
# Keygen DB 백업 한 번: 백업 → 보관 정리 → WAL 검증 → WAL 보관 상태 확인 → 알림.
#   keygen-backup          오늘이 BACKUP_FULL_WEEKDAY면 전체, 아니면 증분(델타)
#   keygen-backup full     전체 백업
#   keygen-backup delta    증분 백업 (이전 백업이 없거나 BACKUP_DELTA_MAX_STEPS를 넘으면 WAL-G가 전체로 한다)
# keygen-backup 컨테이너(예약 실행)와 수동 실행 모두 이 스크립트를 쓴다. 성공하면 0, 실패하면 1.
set -uo pipefail

mode="${1:-auto}"
data_dir="${PGDATA:-/var/lib/postgresql/data}"
retain_full="${BACKUP_RETAIN_FULL:-4}"
full_weekday="${BACKUP_FULL_WEEKDAY:-7}"   # 1=월 … 7=일
label="${BACKUP_LABEL:-keygen}"
[ -n "${BACKUP_TZ:-}" ] && export TZ="$BACKUP_TZ"

log="$(mktemp)"
trap 'rm -f "$log"' EXIT
started="$(date +%s)"
failed_step=""
warning=""

say() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$log"; }

run() {
  say "+ $*"
  "$@" >>"$log" 2>&1
  local rc=$?
  [ $rc -eq 0 ] || say "  -> 실패 (종료 코드 $rc)"
  return $rc
}

# 알림은 백업 결과를 바꾸지 않는다. 보내기에 실패해도 로그만 남긴다.
post_json() {
  local url="$1" body="$2"
  curl -fsS -m 15 -X POST -H 'Content-Type: application/json' --data "$body" "$url" >/dev/null 2>>"$log" \
    || say "알림 전송 실패: ${url%%\?*}"
}

notify_webhook() {
  local status="$1" text="$2"
  [ -n "${BACKUP_WEBHOOK_URL:-}" ] || return 0
  [ "$status" = "success" ] && [ "${BACKUP_NOTIFY_SUCCESS:-true}" != "true" ] && return 0
  local body
  case "${BACKUP_WEBHOOK_FORMAT:-text}" in
    discord) body="$(jq -n --arg t "$text" '{content: $t}')" ;;
    json)    body="$(jq -n --arg s "$status" --arg t "$text" --arg l "$label" --arg m "$mode" \
                       --argjson d "$(( $(date +%s) - started ))" \
                       '{status: $s, label: $l, mode: $m, durationSeconds: $d, text: $t}')" ;;
    *)       body="$(jq -n --arg t "$text" '{text: $t}')" ;;   # Slack · Mattermost · Google Chat · Rocket.Chat
  esac
  post_json "$BACKUP_WEBHOOK_URL" "$body"
}

# 백업이 아예 돌지 않은 것(서버 다운, 예약 멈춤)은 위 웹훅으로 알 수 없다.
# 감시 서비스(Healthchecks / Uptime Kuma Push)가 정해진 시간 안에 성공 신호가 없으면 따로 알린다.
ping_health() {
  local status="$1" msg="$2" url="${BACKUP_HEALTHCHECK_URL:-}"
  [ -n "$url" ] || return 0
  case "${BACKUP_HEALTHCHECK_STYLE:-healthchecks}" in
    uptime-kuma)
      [ "$status" = "start" ] && return 0
      local up="up"; [ "$status" = "fail" ] && up="down"
      curl -fsS -m 15 -G "$url" --data-urlencode "status=$up" --data-urlencode "msg=$msg" >/dev/null 2>>"$log" \
        || say "감시 신호 전송 실패" ;;
    *)
      local suffix=""
      [ "$status" = "start" ] && suffix="/start"
      [ "$status" = "fail" ] && suffix="/fail"
      curl -fsS -m 15 -X POST --data-binary "$msg" "${url%/}${suffix}" >/dev/null 2>>"$log" \
        || say "감시 신호 전송 실패" ;;
  esac
}

finish() {
  local seconds=$(( $(date +%s) - started ))
  if [ -z "$failed_step" ]; then
    local text="✅ [$label] DB 백업 성공 ($kind, ${seconds}초)"
    [ -n "$warning" ] && text="$text"$'\n'"⚠️ $warning"
    say "$text"
    notify_webhook success "$text"
    ping_health success "$text"
    exit 0
  fi
  local tail_lines
  tail_lines="$(grep -v '^$' "$log" | tail -n 8)"
  local text="❌ [$label] DB 백업 실패 ($kind, 단계: $failed_step, ${seconds}초)"$'\n'"$tail_lines"
  say "백업 실패 (단계: $failed_step)"
  notify_webhook failure "$text"
  ping_health fail "$text"
  exit 1
}

case "$mode" in
  full)  push_args=(--full); kind="전체" ;;
  delta) push_args=();       kind="증분" ;;
  auto)
    if [ "$(date +%u)" = "$full_weekday" ]; then push_args=(--full); kind="전체"
    else push_args=(); kind="증분"; fi ;;
  *) echo "사용법: keygen-backup [auto|full|delta]" >&2; exit 2 ;;
esac

ping_health start "starting"
say "[$label] $kind 백업 시작"

# 이 경로의 최신 백업이 지금 DB의 것인지 본다. 다른 DB(새로 만든 DB, 다른 서버)의 백업 위에 증분을 쌓거나
# 보관 정리로 그 DB의 백업을 지우지 않게 한다. 복원한 DB는 system_identifier가 같아서 그대로 이어진다.
# (system_identifier는 jq 숫자 범위를 넘으므로 문자열 그대로 꺼낸다.)
cluster_id="$(psql -Atc "select system_identifier from pg_control_system()" 2>>"$log")"
if [ -z "$cluster_id" ]; then
  failed_step="DB 연결(psql)"; finish
fi
latest_id="$(walg backup-list --detail --json 2>>"$log" | grep -o '"system_identifier":[0-9]*' | tail -n 1 | cut -d: -f2)"
if [ -n "$latest_id" ] && [ "$latest_id" != "$cluster_id" ]; then
  failed_step="다른 DB의 백업이 있는 경로 (이 DB $cluster_id, 저장소 최신 $latest_id). BACKUP_S3_PATH를 새 경로로 바꾸세요"; finish
fi

if ! run walg backup-push "$data_dir" "${push_args[@]}"; then
  failed_step="backup-push"; finish
fi

if ! run walg delete retain FULL "$retain_full" --confirm; then
  failed_step="보관 정리(delete retain FULL $retain_full)"; finish
fi

# WAL이 끊긴 곳 없이 이어져 있는지. 끊겼으면 그 구간 이후로는 시점 복원을 할 수 없다.
verify="$(walg wal-verify integrity timeline --json 2>>"$log" | tail -n 1)"
integrity="$(jq -r '.integrity.status // "UNKNOWN"' <<<"$verify" 2>/dev/null || echo UNKNOWN)"
timeline="$(jq -r '.timeline.status // "UNKNOWN"' <<<"$verify" 2>/dev/null || echo UNKNOWN)"
say "wal-verify: integrity=$integrity timeline=$timeline"
case "$integrity" in
  OK) ;;
  WARNING) warning="WAL 검증 경고(integrity=WARNING). 최근 WAL이 아직 올라가는 중일 수 있습니다." ;;
  *) failed_step="WAL 검증(integrity=$integrity)"; finish ;;
esac
[ "$timeline" = "OK" ] || warning="${warning:+$warning }타임라인 검증: $timeline"

# archive_command가 마지막 성공 이후에 실패하고 있으면 서버에 WAL이 쌓여 디스크가 찬다.
archiver="$(psql -Atc "select coalesce(last_failed_time > coalesce(last_archived_time, 'epoch'), false), failed_count, coalesce(last_failed_wal, '') from pg_stat_archiver" 2>>"$log")"
if [ -z "$archiver" ]; then
  failed_step="WAL 보관 상태 확인(psql 연결)"; finish
fi
IFS='|' read -r archive_failing failed_count failed_wal <<<"$archiver"
if [ "$archive_failing" = "t" ]; then
  failed_step="WAL 보관(archive_command)이 실패 중 (실패 $failed_count회, 마지막 $failed_wal)"; finish
fi

finish
