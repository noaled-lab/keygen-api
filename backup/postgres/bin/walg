#!/bin/bash
# WAL-G 실행 래퍼. .env.backup의 BACKUP_* 값을 WAL-G · S3 환경변수로 옮긴 뒤 wal-g를 실행한다.
# archive_command('walg wal-push %p'), 예약 백업, 복원 모두 이 래퍼를 쓴다. 값이 없으면 실패한다 (WAL을 버리지 않는다).
set -euo pipefail

missing=()
for name in BACKUP_S3_ENDPOINT BACKUP_S3_BUCKET BACKUP_S3_ACCESS_KEY BACKUP_S3_SECRET_KEY BACKUP_ENCRYPTION_KEY; do
  [ -n "${!name:-}" ] || missing+=("$name")
done
if [ ${#missing[@]} -gt 0 ]; then
  echo "walg: .env.backup에 값이 없습니다: ${missing[*]}" >&2
  exit 1
fi

path="${BACKUP_S3_PATH:-keygen}"
export WALG_S3_PREFIX="s3://${BACKUP_S3_BUCKET}/${path#/}"
export AWS_ENDPOINT="$BACKUP_S3_ENDPOINT"
export AWS_REGION="${BACKUP_S3_REGION:-us-east-1}"
export AWS_ACCESS_KEY_ID="$BACKUP_S3_ACCESS_KEY"
export AWS_SECRET_ACCESS_KEY="$BACKUP_S3_SECRET_KEY"
# RustFS · MinIO 등 S3 호환 저장소는 경로 방식(http://주소/버킷/...)을 쓴다.
export AWS_S3_FORCE_PATH_STYLE="${BACKUP_S3_FORCE_PATH_STYLE:-true}"
# 업로드 전에 암호화한다 (libsodium). 키는 32바이트: openssl rand -hex 32
export WALG_LIBSODIUM_KEY="$BACKUP_ENCRYPTION_KEY"
export WALG_LIBSODIUM_KEY_TRANSFORM="${BACKUP_ENCRYPTION_KEY_TRANSFORM:-hex}"
export WALG_COMPRESSION_METHOD="${BACKUP_COMPRESSION:-zstd}"
# 증분(델타) 백업을 몇 번까지 이어 쌓을지. 이 횟수를 넘으면 WAL-G가 자동으로 전체 백업을 한다.
export WALG_DELTA_MAX_STEPS="${BACKUP_DELTA_MAX_STEPS:-6}"
# 같은 이름의 다른 WAL이 이미 있으면 덮어쓰지 않고 실패한다 (다른 DB가 같은 경로를 쓰는 사고 방지).
export WALG_PREVENT_WAL_OVERWRITE="${BACKUP_PREVENT_WAL_OVERWRITE:-true}"

exec /usr/local/bin/wal-g "$@"
