# Keygen DB 백업 설정 (WAL-G → S3 호환 저장소, 예: RustFS).
# 이 파일을 .env.backup으로 복사해 채운다. .env.backup은 비밀값이라 커밋하지 않는다 (.gitignore의 /.env*).
# keygen-postgres(WAL 업로드)와 keygen-backup(예약 백업)이 같이 읽는다. 자세한 것은 BACKUP.md.

# ── 저장소 (필수) ──────────────────────────────────────────────
# S3 API 주소. 컨테이너에서 닿는 주소여야 한다 (예: https://s3.example.com, 같은 Docker 네트워크면 http://rustfs:9000).
BACKUP_S3_ENDPOINT=https://<rustfs 주소>
# 버킷은 미리 만들어 둔다 (WAL-G는 버킷을 만들지 않는다).
BACKUP_S3_BUCKET=<버킷 이름>
# 버킷 안의 경로. 서버마다 다르게 두면 한 버킷을 같이 쓸 수 있다.
BACKUP_S3_PATH=keygen
# RustFS는 리전을 따지지 않는다. 저장소가 정한 값이 있으면 그 값.
BACKUP_S3_REGION=us-east-1
# RustFS · MinIO는 경로 방식(http://주소/버킷/...)이라 true.
BACKUP_S3_FORCE_PATH_STYLE=true
# 이 경로만 읽기 · 쓰기 · 삭제(보관 정리)할 수 있는 백업 전용 키를 쓴다 (관리자 키 말고).
BACKUP_S3_ACCESS_KEY=<액세스 키>
BACKUP_S3_SECRET_KEY=<비밀 키>

# ── 암호화 (필수) ──────────────────────────────────────────────
# 업로드 전에 암호화하는 키 (32바이트, 16진수 64자). 만들기: openssl rand -hex 32
# ⚠️ 잃으면 백업을 열 수 없다. 비밀번호 관리자 등 S3가 아닌 곳에 따로 보관한다. 한 번 정하면 바꾸지 않는다.
BACKUP_ENCRYPTION_KEY=<openssl rand -hex 32>

# ── 일정 · 보관 ────────────────────────────────────────────────
# 예약 시각 (cron 식: 분 시 일 월 요일)과 시간대.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TZ=Asia/Seoul
# 전체 백업 요일 (1=월 … 7=일). 다른 날은 증분.
BACKUP_FULL_WEEKDAY=7
# 증분을 몇 번까지 이어 쌓을지. 넘으면 WAL-G가 알아서 전체 백업을 한다 (전체 요일을 놓쳤을 때의 안전장치).
BACKUP_DELTA_MAX_STEPS=6
# 전체 백업 몇 개를 남길지 (딸린 증분 · WAL도 같이 정리). 4면 약 4주.
BACKUP_RETAIN_FULL=4
# 압축: zstd(기본) · lz4 · brotli
BACKUP_COMPRESSION=zstd

# ── 알림 (선택) ────────────────────────────────────────────────
# 백업이 끝날 때 보낼 웹훅 주소. 비우면 보내지 않는다.
BACKUP_WEBHOOK_URL=
# text: {"text": …} (Slack · Mattermost · Google Chat · Rocket.Chat)
# discord: {"content": …}
# json: {"status","label","mode","durationSeconds","text"} (직접 받는 서버용)
BACKUP_WEBHOOK_FORMAT=text
# 성공도 알릴지 (false면 실패만).
BACKUP_NOTIFY_SUCCESS=true
# 알림에 붙는 이름.
BACKUP_LABEL=keygen

# 감시 서비스 주소. 정해진 시간 안에 성공 신호가 없으면 감시 서비스가 알린다 (서버 다운 · 예약 멈춤 대비).
# healthchecks: Healthchecks.io(또는 직접 운영) 주소. 시작 /start, 성공, 실패 /fail 신호를 보낸다.
# uptime-kuma: Uptime Kuma Push 주소 (…/api/push/<토큰>). status=up|down&msg=… 를 붙여 보낸다.
BACKUP_HEALTHCHECK_URL=
BACKUP_HEALTHCHECK_STYLE=healthchecks
