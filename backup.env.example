# Keygen DB 백업 설정 (WAL-G → S3 호환 저장소 / RustFS). 서버에서 .env.backup으로 복사해 채운다.
# .env.backup은 비밀값이라 커밋하지 않는다 (.gitignore의 /.env*). keygen-postgres와 keygen-backup이 같이 읽는다.

# ── 저장소 (필수) ──
# s3://<버킷>/<경로>. 버킷은 미리 만들어 둔다. 경로 하나에는 DB 하나만 백업한다.
WALG_S3_PREFIX=s3://<버킷>/keygen
# S3 API 주소 (컨테이너에서 닿는 주소)
AWS_ENDPOINT=https://<rustfs 주소>
AWS_REGION=us-east-1
# RustFS는 경로 방식 주소를 쓴다
AWS_S3_FORCE_PATH_STYLE=true
# 이 경로만 읽기 · 쓰기 · 삭제할 수 있는 백업 전용 키
AWS_ACCESS_KEY_ID=<액세스 키>
AWS_SECRET_ACCESS_KEY=<비밀 키>

# ── 암호화 (필수) ──
# 올리기 전에 암호화하는 키. 만들기: openssl rand -hex 32
# ⚠️ 잃으면 백업을 열 수 없다. 비밀번호 관리자 등 S3가 아닌 곳에 따로 보관하고, 한 번 정하면 바꾸지 않는다.
WALG_LIBSODIUM_KEY=<openssl rand -hex 32>
WALG_LIBSODIUM_KEY_TRANSFORM=hex

# ── WAL-G 동작 ──
WALG_COMPRESSION_METHOD=zstd
# 증분을 이만큼 이어 쌓으면 다음은 자동으로 전체 백업
WALG_DELTA_MAX_STEPS=6
# 같은 이름의 다른 WAL이 이미 있으면 덮어쓰지 않고 실패 (다른 DB가 같은 경로를 쓰는 사고 방지)
WALG_PREVENT_WAL_OVERWRITE=true

# ── 일정 · 보관 · 알림 ──
TZ=Asia/Seoul
# 매일 백업 시각 (HH:MM)
BACKUP_TIME=03:00
# 전체 백업 요일 (1=월 … 7=일). 다른 날은 증분
BACKUP_FULL_WEEKDAY=7
# 전체 백업 몇 개를 남길지 (딸린 증분 · WAL도 같이 정리). 4면 약 4주
BACKUP_RETAIN_FULL=4
# 성공 · 실패를 보낼 웹훅 ({"text": "..."} 형식: Slack · Mattermost · Google Chat 등). 비우면 보내지 않는다
BACKUP_WEBHOOK_URL=
